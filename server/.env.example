# Copia este archivo a .env y completa los valores. No subas .env al repositorio.

# Puerto HTTP del servidor.
PORT=3000

# Panel de Supabase -> Project Settings -> API. URL del proyecto, sin barra final.
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Panel de Supabase -> Project Settings -> API Keys. Clave PÚBLICA: anon o publishable (sb_publishable_...).
# NUNCA la clave service_role ni sb_secret_...: el servidor la rechaza al arrancar.
SUPABASE_ANON_KEY=

# Solo si el proyecto aún firma con el secreto HS256 heredado (Project Settings -> JWT Keys).
# Lo normal es dejarlo vacío: las sesiones se verifican con las claves públicas (JWKS) del proyecto.
SUPABASE_JWT_SECRET=

# Opcional: explicación de términos con Google Gemini (nivel gratuito, sin facturación).
# Obtén la clave en Google AI Studio. Sin esta variable, la función queda desactivada y el resto de la app funciona igual.
# Nunca la pongas en el frontend ni en el repositorio.
GEMINI_API_KEY=
# Modelo de Gemini. Verifica en Google AI Studio que sea gratuito antes de usarlo.
GEMINI_MODELO=gemini-3.5-flash-lite
